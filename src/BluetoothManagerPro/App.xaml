<Application x:Class="BluetoothManagerPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BluetoothManagerPro.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:CategoryToIconConverter x:Key="CategoryToIcon" />
            <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:BatteryToBrushConverter x:Key="BatteryToBrush" />
            <infra:SignalBarConverter x:Key="SignalBar" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
