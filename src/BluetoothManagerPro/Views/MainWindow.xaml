<Window x:Class="BluetoothManagerPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:BluetoothManagerPro.ViewModels"
        Title="Bluetooth Manager Pro"
        Width="460" Height="680"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Surface.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource Font.Size.Body}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- One device in the main list. -->
        <DataTemplate x:Key="DeviceRowTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="Row"
                    Background="Transparent"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="8,8,8,8"
                    Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Type badge; fills with the accent while connected. -->
                    <Border x:Name="Badge" Grid.Column="0"
                            Width="38" Height="38"
                            Background="{DynamicResource Brush.Surface.Overlay}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Grid>
                            <Border Style="{StaticResource Relief.Raised}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Path Data="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                  Style="{StaticResource IconPath}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource Text.Body}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="Status"
                                       Text="{Binding StatusText}"
                                       Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center" />

                            <!-- Battery -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                                <Path Data="{StaticResource Icon.Battery}"
                                      Style="{StaticResource IconPath.Small}"
                                      Width="15" Height="15"
                                      Stroke="{Binding BatteryPercent, Converter={StaticResource BatteryToBrush}}" />
                                <TextBlock Text="{Binding BatteryText}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding BatteryPercent, Converter={StaticResource BatteryToBrush}}" />
                            </StackPanel>

                            <!-- Signal, only meaningful before a device connects. -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasSignal, Converter={StaticResource BoolToVisibility}}">
                                <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource Brush.Text.Secondary}"
                                           Opacity="{Binding SignalBars, Converter={StaticResource SignalBar}, ConverterParameter=1}" />
                                <Rectangle Width="2" Height="8" RadiusX="1" RadiusY="1" Margin="2,0,0,0" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource Brush.Text.Secondary}"
                                           Opacity="{Binding SignalBars, Converter={StaticResource SignalBar}, ConverterParameter=2}" />
                                <Rectangle Width="2" Height="11" RadiusX="1" RadiusY="1" Margin="2,0,0,0" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource Brush.Text.Secondary}"
                                           Opacity="{Binding SignalBars, Converter={StaticResource SignalBar}, ConverterParameter=3}" />
                                <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1" Margin="2,0,0,0" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource Brush.Text.Secondary}"
                                           Opacity="{Binding SignalBars, Converter={StaticResource SignalBar}, ConverterParameter=4}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!--
                            A plain Button, not a ToggleButton: clicking a ToggleButton
                            writes IsChecked locally and would wipe out the binding.
                            The state is shown by the trigger below instead.
                        -->
                        <Button Style="{StaticResource Button.Icon}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="В избранное">
                            <Path x:Name="StarIcon"
                                  Data="{StaticResource Icon.Star}"
                                  Style="{StaticResource IconPath.Small}" />
                        </Button>

                        <Button x:Name="ConnectButton"
                                Style="{StaticResource Button.Secondary}"
                                Margin="4,0,0,0"
                                MinWidth="92"
                                Padding="10,6"
                                Content="{Binding ConnectionActionText}"
                                Command="{Binding DataContext.ToggleConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />

                        <Button x:Name="PairButton"
                                Style="{StaticResource Button.Primary}"
                                Margin="4,0,0,0"
                                MinWidth="92"
                                Padding="10,6"
                                Content="Сопрячь"
                                Visibility="Collapsed"
                                Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />

                        <Button x:Name="UnpairButton"
                                Style="{StaticResource Button.Icon}"
                                Margin="2,0,0,0"
                                ToolTip="Удалить сопряжение"
                                Command="{Binding DataContext.UnpairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource IconPath.Small}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Accent.Muted}" />
                    <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Positive}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="StarIcon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="StarIcon" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>

                <!-- Unpaired devices offer pairing instead of connect / remove. -->
                <DataTrigger Binding="{Binding IsPaired}" Value="False">
                    <Setter TargetName="ConnectButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="UnpairButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PairButton" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="Row" Property="IsEnabled" Value="False" />
                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                </DataTrigger>

                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="DeviceItemContainer" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Title bar ==================== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="42" Background="{DynamicResource Brush.Surface.Base}">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.Bluetooth}"
                      Style="{StaticResource IconPath.Small}"
                      Stroke="{DynamicResource Brush.Accent}" />
                <TextBlock Text="Bluetooth Manager"
                           Style="{StaticResource Text.Body}"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Button.TitleBar}"
                        Click="OnMinimiseClick"
                        ToolTip="Свернуть">
                    <Path Data="{StaticResource Icon.Minimize}" Style="{StaticResource IconPath.Small}" />
                </Button>
                <Button Style="{StaticResource Button.TitleBar.Close}"
                        Click="OnCloseClick"
                        ToolTip="Закрыть">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath.Small}" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Everything that swaps between tabs lives in one host so a single opacity
            animation can fade the lot; the panes inside are exchanged at the trough of
            that fade, which is why the switch reads as a dissolve rather than a cut.
        -->
        <Grid x:Name="ContentHost" Grid.Row="1">

            <Grid x:Name="DevicesPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <!-- ==================== Radio card ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="16,4,16,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RadioBadge" Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Background="{DynamicResource Brush.Surface.Overlay}"
                        TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
                    <Grid>
                        <Border Style="{StaticResource Relief.Raised}"
                                CornerRadius="{StaticResource Radius.Medium}" />
                        <Path Data="{StaticResource Icon.Bluetooth}" Style="{StaticResource IconPath}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RadioStatusText}"
                               Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                               Text="Адаптер этого компьютера" />
                </StackPanel>

                <ToggleButton Grid.Column="2"
                              Style="{StaticResource Toggle.Switch}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding RadioSwitch, Mode=TwoWay}"
                              IsEnabled="{Binding IsRadioAvailable}"
                              ToolTip="Включить или выключить Bluetooth" />
            </Grid>
        </Border>

        <!-- ==================== Toolbar ==================== -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource TextBox.Search}"
                     Tag="Поиск по названию"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Primary}"
                    Margin="8,0,0,0"
                    Command="{Binding ScanCommand}"
                    ToolTip="Искать новые устройства (30 секунд)">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource IconPath.Small}" />
                    <TextBlock Text="Поиск" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!--
            Reserves the strip the scan bar floats over, and gives the code-behind a
            measurable anchor for the bar's resting position. The bar is not in here: it
            has to travel across the whole window, so it is an overlay further down.
        -->
        <Border x:Name="ScanSpacer" Grid.Row="2"
                Height="14"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

        <!-- ==================== Device list ==================== -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <ScrollViewer Padding="10,0,6,0">
                <ItemsControl ItemsSource="{Binding DevicesView}"
                              ItemTemplate="{StaticResource DeviceRowTemplate}"
                              Margin="6,0,6,12">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource Text.SectionHeader}"
                                               Margin="10,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Path Data="{StaticResource Icon.Bluetooth}"
                      Style="{StaticResource IconPath.Large}"
                      Width="40" Height="40"
                      Stroke="{DynamicResource Brush.Text.Disabled}" />
                <TextBlock Text="Устройств пока нет"
                           Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="Нажмите «Поиск», чтобы найти устройства рядом"
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

                </Grid>
            </Grid>

            <!-- ==================== Settings panel ==================== -->
            <ScrollViewer x:Name="SettingsPane" Padding="16,0" Visibility="Collapsed">
                <StackPanel Margin="0,4,0,16">

                    <!-- Themes lead the settings: it is the thing people come here to change. -->
                    <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource Text.SectionHeader}" Margin="0,8,0,8" />

                    <Border Style="{StaticResource Card}" Padding="14,14">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Accents}" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- GroupName makes the swatches mutually exclusive for free. -->
                                        <RadioButton Style="{StaticResource Swatch}"
                                                     GroupName="Accent"
                                                     Margin="0,0,6,0"
                                                     Background="{Binding Swatch}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,14,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Светлая тема"
                                               Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="Не белая — приглушённый оттенок выбранного цвета" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Toggle.Switch}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ОПЦИИ" Style="{StaticResource Text.SectionHeader}" Margin="0,20,0,8" />

                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Лёгкий режим"
                                               Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="Без анимаций, теней и рельефа, опрос устройств реже — минимум нагрузки" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Toggle.Switch}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              IsChecked="{Binding LiteMode, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,12,0,12" />

                            <CheckBox Style="{StaticResource CheckBox.Default}"
                                      Content="Запускать вместе с Windows"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource CheckBox.Default}"
                                      Margin="0,12,0,0"
                                      Content="При автозапуске сворачивать в трей"
                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource CheckBox.Default}"
                                      Margin="0,12,0,0"
                                      Content="Кнопка «Закрыть» сворачивает в трей"
                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource CheckBox.Default}"
                                      Margin="0,12,0,0"
                                      Content="Скрывать устройства без названия"
                                      IsChecked="{Binding HideUnnamedDevices, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ПАРАМЕТРЫ WINDOWS" Style="{StaticResource Text.SectionHeader}" Margin="0,20,0,8" />

                    <Border Style="{StaticResource Card}" Padding="6">
                        <ItemsControl ItemsSource="{Binding SystemSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Ghost}"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,9"
                                            Command="{Binding DataContext.OpenSystemSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Target}">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Path Data="{StaticResource Icon.External}"
                                                  Style="{StaticResource IconPath.Small}"
                                                  HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="4,16,4,0"
                               TextWrapping="Wrap"
                               Text="Заряд батареи доступен не для всех устройств: Windows получает его только от гарнитур, которые сами сообщают уровень заряда." />

                    <TextBlock Text="{Binding AppFooter}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"
                               Opacity="0.45" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== Status bar ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="16,9"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Info}"
                      Style="{StaticResource IconPath.Small}"
                      Stroke="{DynamicResource Brush.Accent}"
                      VerticalAlignment="Top"
                      Margin="0,1,0,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ==================== Bottom tabs ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0"
                             Style="{StaticResource Tab}"
                             GroupName="MainTabs"
                             IsChecked="{Binding IsDevicesTab, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Bluetooth}" Style="{StaticResource IconPath.Small}" />
                        <TextBlock Text="Устройства" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Column="1"
                             Style="{StaticResource Tab}"
                             GroupName="MainTabs"
                             IsChecked="{Binding IsSettingsTab, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource IconPath.Small}" />
                        <TextBlock Text="Настройки" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Border>

        <!--
            The scan bar. Declared last and spanning every row, so it paints over the whole
            window and can glide across it while the tabs dissolve underneath. Its position
            is driven from the code-behind, which owns the choreography.
        -->
        <ProgressBar x:Name="ScanOverlay"
                     Grid.Row="0" Grid.RowSpan="4"
                     Style="{StaticResource ScanBar}"
                     VerticalAlignment="Top"
                     Margin="16,0,16,0"
                     IsHitTestVisible="False"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
